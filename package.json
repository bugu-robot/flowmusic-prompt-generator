{
  "name": "flowmusic-prompt-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "npm run audio:package",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "audio:install": "bash scripts/audio-preview/install-deps.sh",
    "audio:build": "npm run audio:install && node --import=tsx scripts/audio-preview/build.ts",
    "audio:qc": "node --import=tsx scripts/audio-preview/qc-cli.ts",
    "audio:package": "python3 scripts/audio-preview/package_review.py . public/audio-preview-review.zip",
    "audio:verify": "node --import=tsx scripts/audio-preview/verify.ts",
    "audio:all": "npm run audio:build && npm run audio:verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
